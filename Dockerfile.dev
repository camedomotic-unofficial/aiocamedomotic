FROM python:3.14-alpine

# Optionally trust an extra root CA (e.g. a local HTTPS-inspecting filter or
# proxy). Put it in PEM format at .devcontainer/extra-ca.pem (git-ignored);
# if the file is absent this step does nothing. The CA is appended to the
# system bundle right away so that `apk` can already use it, and copied to
# /usr/local/share/ca-certificates so that `update-ca-certificates` keeps it.
RUN --mount=type=bind,source=.devcontainer,target=/tmp/devcontainer \
    if [ -f /tmp/devcontainer/extra-ca.pem ]; then \
        mkdir -p /usr/local/share/ca-certificates && \
        cp /tmp/devcontainer/extra-ca.pem \
            /usr/local/share/ca-certificates/extra-ca.crt && \
        cat /tmp/devcontainer/extra-ca.pem >> /etc/ssl/certs/ca-certificates.crt; \
    fi

# Make Python (requests/poetry/pip) and Node use the system CA bundle, so any
# extra CA installed above is honored by them too
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Update certificates and install necessary packages
RUN apk update && \
    apk add --no-cache ca-certificates && \
    update-ca-certificates && \
    apk add --no-cache \
        bash \
        git \
        openssh-client \
        gcc \
        musl-dev \
        linux-headers \
        python3-dev \
        libffi-dev \
        openssl-dev \
        nodejs \
        npm \
        coreutils \
        github-cli \
        ripgrep \
        tmux

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /usr/src
RUN git clone --depth 1 https://github.com/camedomotic-unofficial/aiocamedomotic
WORKDIR /usr/src/aiocamedomotic

# Create a non-root user
RUN adduser -D vscode
# Create npm global directory for the vscode user
RUN mkdir -p /home/vscode/.npm-global
RUN chown -R vscode:vscode /home/vscode/.npm-global

USER vscode
# Configure npm to use the new directory path
RUN npm config set prefix '/home/vscode/.npm-global'

# Add npm global bin to PATH
ENV PATH="/home/vscode/.npm-global/bin:$PATH"

# Upgrade npm: the Alpine-packaged npm 11.12.1 wrongly rejects the
# `npm install --allow-git=root git+file://...` command that pre-commit uses to
# install node-based hooks (e.g. prettier), failing with EALLOWGIT
RUN npm install -g npm@11

# Install Claude Code globally
RUN npm install -g @anthropic-ai/claude-code

ENV VIRTUAL_ENV="/home/vscode/.local/aiocamedomotic-venv"
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install poetry directly in the virtual environment
RUN pip install --upgrade pip && \
    pip install poetry

# Activate the virtual environment and install dependencies
RUN . $VIRTUAL_ENV/bin/activate && poetry install --with tests,docs,code-quality,dev

WORKDIR /workspaces

# Set the default shell to bash instead of sh
ENV SHELL /bin/bash
